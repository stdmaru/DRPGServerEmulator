<Project Sdk="Microsoft.NET.Sdk">

  <!-- Login + auto-patcher (docs/planos/cliente-novo.md, milestone 1).
       NativeAOT, no single-file, no compression, no obfuscation (antivirus false positives). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DRPG.Launcher</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DRPG.Launcher</AssemblyName>
    <Product>DRPG Launcher</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DRPG.Shared\DRPG.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="drpg-launcher.ini.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DRPG.Launcher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>

</Project>
