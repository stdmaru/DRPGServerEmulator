<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DRPG.Server</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DRPG.Shared\DRPG.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tabelas do jogo (XML) e migrações do banco vão junto do binário. -->
    <None Include="Resources\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- fora do git: copie do cliente (docs/cliente/arquivos-de-dados.md) -->
    <None Include="Resources\Client\table.hf;Resources\Client\table.pf" Condition="Exists('Resources\Client\table.pf')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\Client\grids.bin" Condition="Exists('Resources\Client\grids.bin')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\sql\upgrade\*.sql" Link="sql\upgrade\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Payloads capturados ainda não decodificados (ver Network/Packets/Templates/README.md). -->
    <EmbeddedResource Include="Network\Packets\Templates\*.hex" LogicalName="Templates.%(Filename)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DRPG.Server.Tests" />
  </ItemGroup>

</Project>
